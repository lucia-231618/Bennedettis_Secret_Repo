  m_Script: {fileID: 11500000, guid: b9d4ee9374a7e744f8fb652e90cc71cf, type: 3}
  m_Name: MeetDonatello
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - character: Donatello Benedetti
    text: "Ah\u2026 te estaba esperando\u2026"
  - character: Donatello Benedetti
    text: "No todos los vivos pueden percibir lo que yace en esta mansi\xF3n\u2026
      pero t\xFA\u2026 pareces diferente."
  - character: Donatello Benedetti
    text: "Si quieres descubrir la verdad sobre mi nieta Adriana, debes escuchar
      a quienes quedaron atrapados aqu\xED y recuperar lo que era valioso para ellos."
  - character: Donatello Benedetti
    text: "Yo te ayudar\xE9 si me encuentras el reloj de bolsillo de mi t\xE1tara-t\xE1tara-t\xE1tara-t\xE1tara-t\xE1tara-t\xE1tara"
  - character: 
    text: "\u2026 \xA1YA ME QUED\xD3 CLARO!"
  - character: Donatello Benedetti
    text: "t\xE1tara-t\xE1tara abuelo "

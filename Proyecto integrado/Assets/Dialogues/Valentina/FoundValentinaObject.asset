  m_Script: {fileID: 11500000, guid: b9d4ee9374a7e744f8fb652e90cc71cf, type: 3}
  m_Name: FoundValentinaObject
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - character: Valentina Benedetti
    text: "\xA1Oh\u2026 lo has encontrado! Sab\xEDa que lo conseguir\xEDas"
  - character: Valentina Benedetti
    text: "Este guardapelo\u2026 contiene tanto de m\xED\u2026 de mi familia\u2026
      ahora puedo descansar un poco\u2026 gracias"
  - character: Valentina Benedetti
    text: "Pero no es solo un objeto\u2026 hay cosas que debes saber si quieres entender
      la verdad sobre Adriana."
  - character: Valentina Benedetti
    text: "El d\xEDa que se cometi\xF3 el crimen estuve todo el d\xEDa  fuera de
      la casa con mi hija\u2026 y aunque mi hija y Adriana nunca se llevaron bien
      no la eduqu\xE9 para ser un monstruo"
